# Copia este archivo como .env y completa los valores reales.
# En Render, crea estas mismas variables en "Environment".

# Supabase → Connect → Session pooler (funciona en Render, que no tiene IPv6)
DATABASE_URL=postgresql://postgres.TU_PROYECTO_REF:TU_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Contraseña del modo administrador (editar, eliminar, ver clientes y citas)
ADMIN_KEY=una-contraseña-larga-y-dificil

# Webhook de Slack para avisos de nuevas citas y productos (opcional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# Dominios que pueden llamar a la API, separados por comas
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
